@import "./launcher.rasi"
window {
    width: 700px;
}
listview {
    columns: 6;
    lines: 7;
    spacing: 8px;
    fixed-columns: true;
}
element {
    orientation: horizontal;
    padding: 10px;
    border-radius: 8px;
}
element-text {
    font: "Noto Color Emoji 18, JetBrains Mono Nerd Font 13";
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
